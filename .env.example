# Server Configuration
PORT=5000
NODE_ENV=development

# Database (local MongoDB or MongoDB Atlas connection string)
MONGODB_URI=mongodb://localhost:27017/coursemaster

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this

# Admin Registration Key (used on the Register page to create an admin)
ADMIN_REGISTRATION_KEY=your-secret-admin-key-here

# Email Configuration (optional - welcome emails)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
FRONTEND_URL=http://localhost:5173
